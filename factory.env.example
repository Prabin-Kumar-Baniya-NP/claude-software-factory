# Copy to factory.env and edit. `bin/factory` loads it automatically.
# Every value can also be set as a normal environment variable.

# Repos to watch (comma separated owner/repo). Required.
FACTORY_REPOS=owner/repo

# The label that hands an issue to the factory.
FACTORY_LABEL=factory

# How often to look at GitHub, in seconds.
FACTORY_POLL_SECONDS=60

# How many Claude runs at once (across all repos).
FACTORY_MAX_PARALLEL=2

# Model and effort for every run and every subagent.
FACTORY_MODEL=opus
FACTORY_EFFORT=high

# Stop a single run after this long (timeout(1) syntax).
FACTORY_RUN_TIMEOUT=90m

# Optional --max-budget-usd per run (0 = no cap).
FACTORY_RUN_BUDGET_USD=0

# Builder <-> reviewer rounds before an issue is marked blocked.
FACTORY_MAX_REVIEW_ROUNDS=2

# Big (L) issues wait for your "approve" comment on the breakdown before any code.
FACTORY_EPIC_NEEDS_APPROVAL=true

# GitHub Project board to keep in sync, as owner/number (bin/factory-setup --board prints it).
# Leave empty for no board.
FACTORY_PROJECT=

# Comment text that summons the factory on any issue or PR.
FACTORY_MENTION=@factory

# Allow the factory to change .github/workflows (1 = yes).
FACTORY_ALLOW_WORKFLOWS=0

# Where clones, worktrees, logs and launcher state live.
FACTORY_HOME=$HOME/factory

# "im" = the launcher also sends Interrupt Me notifications when something gets stuck.
FACTORY_NOTIFY=
